---
import BaseLayout from '../layouts/BaseLayout.astro';

const withBase = (path = '') => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<BaseLayout
  title="Legal Notice | Degin Studios"
  description="Legal notice and provider information for Degin Studios."
>
  <main class="page-shell">
    <a class="back-link" href={withBase()}>Back to Degin Studios</a>
    <section class="content-page legal-copy">
      <p class="eyebrow">Legal notice</p>
      <h1>Legal Notice</h1>

      <h2>Information according to Section 5 DDG</h2>
      <p>
        Degin Studios<br />
        Owner: Miguel Degin
      </p>

      <h2>Contact</h2>
      <p>
        Email: <a href="mailto:support@deginstudios.com">support@deginstudios.com</a>
      </p>

      <h2>Responsible for Content</h2>
      <p>
        Miguel Degin<br />
        Degin Studios
      </p>
    </section>
  </main>
</BaseLayout>
